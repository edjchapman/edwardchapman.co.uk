{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edwardchapman",
  // No "main": the @astrojs/cloudflare adapter injects its server entrypoint
  // and the build emits a deploy-ready config under dist/.
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "edwardchapman.co.uk", "custom_domain": true }],
  // Production serves only from the custom domain; PR preview aliases stay on.
  // The www host 301s to the apex via workers/www-redirect.
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": true },
  // Config-driven model selection (spec §2); ANTHROPIC_API_KEY arrives as a
  // Worker secret in Phase 4 via `wrangler secret put ANTHROPIC_API_KEY`.
  "vars": { "ANTHROPIC_MODEL": "claude-haiku-4-5" },
  // Per-IP limiting for /api/ask (ADR-0009): the GA Workers rate-limit
  // binding — no KV/DO/D1.
  "ratelimits": [
    {
      "name": "ASK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
}
