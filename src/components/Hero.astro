---
import { SITE } from "../lib/site";

interface Props {
  tagline: string;
}

const { tagline } = Astro.props;
---

<div class="hero">
  <h1>{SITE.name}</h1>
  <p class="tagline">{tagline}</p>
  <ul class="actions" aria-label="Primary links">
    <li><a href={SITE.github}>GitHub</a></li>
    <li><a href={SITE.linkedin}>LinkedIn</a></li>
    <li><a href={`mailto:${SITE.email}`}>Email</a></li>
  </ul>
</div>

<style>
  /* Bottom margin matches the page's 24px block rhythm — the old --space-2
   * predates the single-paragraph intro and left it glued to the pills. */
  .hero {
    margin-block: var(--space-4);
  }

  /* The accent bar quotes the site's mark: the OG cards and favicon carry
   * the same accent tick over the serif name (ADR-0021's brand assets). */
  .hero::before {
    content: "";
    display: block;
    width: var(--space-6);
    height: 3px;
    background: var(--color-accent);
    margin-bottom: var(--space-4);
  }

  h1 {
    font-size: var(--text-4xl);
    letter-spacing: -0.015em;
  }

  .tagline {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: 1.35;
    color: var(--color-muted);
    text-wrap: balance;
    max-width: 36ch;
  }

  @media (min-width: 64rem) {
    .hero {
      margin-block: var(--space-6) var(--space-5);
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
  }

  .actions a {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius);
    background: var(--color-paper-raised);
    color: var(--color-ink);
    text-decoration: none;
    font-size: var(--text-sm);
    transition:
      color var(--duration-quick) var(--ease-out),
      border-color var(--duration-quick) var(--ease-out),
      box-shadow var(--duration-gentle) var(--ease-out);
  }

  .actions a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    box-shadow: var(--shadow-1);
  }
</style>
