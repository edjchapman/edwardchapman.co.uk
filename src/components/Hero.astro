---
import { SITE } from "../lib/site";

interface Props {
  tagline: string;
  /** Rail eyebrow: role and city-level location (content-policy maximum). */
  eyebrow: string;
}

const { tagline, eyebrow } = Astro.props;
---

<div class="hero u-wide">
  <p class="eyebrow">{eyebrow}</p>
  <div class="body">
    <h1>{SITE.name}</h1>
    <p class="tagline">{tagline}</p>
    <div class="intro"><slot /></div>
    <ul class="actions" aria-label="Primary links">
      <li><a class="primary" href="/projects">Read the case studies</a></li>
      <li><a class="secondary" href="/ask">Ask about Ed's work</a></li>
      <li><a class="email" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
    </ul>
  </div>
</div>

<style>
  .hero {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-4) var(--space-6);
  }

  .eyebrow {
    align-self: start;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  h1 {
    font-size: var(--text-4xl);
    letter-spacing: -0.015em;
  }

  .tagline {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: 1.35;
    text-wrap: balance;
    max-width: 40ch;
    margin-top: var(--space-3);
  }

  .intro {
    color: var(--color-muted);
    max-width: 58ch;
    margin-top: var(--space-4);
  }

  .intro :global(p:last-child) {
    margin-bottom: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }

  .primary,
  .secondary {
    display: inline-block;
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color var(--duration-quick) var(--ease-out),
      color var(--duration-quick) var(--ease-out),
      border-color var(--duration-quick) var(--ease-out);
  }

  .primary {
    background: var(--color-ink);
    border: 1px solid var(--color-ink);
    color: var(--color-paper);
  }

  .primary:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .secondary {
    background: var(--color-paper-raised);
    border: 1px solid var(--color-rule-strong);
    color: var(--color-ink);
  }

  .secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .email {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: var(--rail) minmax(0, 1fr);
      column-gap: var(--space-5);
      padding-block: var(--space-6);
    }

    /* Optical alignment: the eyebrow's cap height meets the h1's. */
    .eyebrow {
      padding-top: 1.1rem;
    }

    /* Sources hang in the rail below the eyebrow, level with the intro. */
    .intro :global(.footnotes) {
      position: absolute;
      top: calc(var(--space-6) + var(--space-7));
      left: 0;
      width: var(--rail);
      margin: 0;
    }
  }
</style>
