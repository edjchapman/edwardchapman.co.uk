---
import type { CollectionEntry } from "astro:content";

import ScaleBars from "./ScaleBars.astro";

interface Props {
  project: CollectionEntry<"projects">;
  /** 3 under a Section h2 (homepage), 2 directly under a page h1
   * (/projects). Visual size is the same either way. */
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const { title, problem, tech, metrics, repo, demo } = project.data;
// One evidence line per row (ADR-0030); the rest stays on the case study.
const evidence = metrics[0];
const caseStudy = `/projects/${project.id}`;
---

<article>
  <div class="main">
    <Heading class="title"><a href={caseStudy}>{title}</a></Heading>
    <p>{problem}</p>
  </div>
  <div class="side">
    {
      evidence && (
        <div class="evidence">
          <p class="figure">{evidence.value}</p>
          <p class="caption">{evidence.label}</p>
          {evidence.scale && (
            <ScaleBars from={evidence.scale.from} to={evidence.scale.to} />
          )}
        </div>
      )
    }
    <ul class="tech" aria-label="Technologies">
      {tech.map((tag) => <li>{tag}</li>)}
    </ul>
    <p class="links">
      <a href={caseStudy} aria-label={`${title} case study`}>Case study</a>
      {demo ? <a href={demo}>Live demo</a> : <a href={repo}>Repository</a>}
    </p>
  </div>
</article>

<style>
  article {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-bottom: var(--rule);
  }

  article:first-child {
    padding-top: 0;
  }

  article:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .main {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    min-width: 0;
  }

  .title {
    margin: 0;
    font-size: var(--text-xl);
  }

  .title a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .title a:hover {
    color: var(--color-accent);
  }

  p {
    margin: 0;
  }

  .side {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .evidence {
    display: grid;
    gap: 0.15rem;
  }

  .figure {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1.12rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-ink);
  }

  .caption {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  @media (min-width: 64rem) {
    article {
      grid-template-columns: minmax(0, 1fr) 15rem;
      column-gap: var(--space-5);
    }

    .side {
      padding-top: 0.4rem;
    }
  }
</style>
