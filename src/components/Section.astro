---
interface Props {
  id: string;
  heading: string;
  /** Let the body run the full wide canvas beside the rail (project index)
   * instead of holding to --measure. */
  wideBody?: boolean;
}

const { id, heading, wideBody = false } = Astro.props;
---

{
  /* Rail layout (ADR-0030): at ≥ 64rem the label (and any rail slot content,
  e.g. sources) sits in a --rail column beside the body, so every section
  shares the wide canvas's left edge. Below that the rail stacks on top. */
}
<section class="u-wide" aria-labelledby={id}>
  <div class="rail">
    <h2 id={id}>{heading}</h2>
    <slot name="rail" />
  </div>
  <div class:list={["body", { wide: wideBody }]}>
    <slot />
  </div>
</section>

<style>
  section {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-5);
    border-top: var(--rule);
  }

  .rail {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  /* Section names are wayfinding, not content: the small mono label register
   * leaves the serif to the content's own headings. */
  h2 {
    margin: 0;
    padding-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .body {
    min-width: 0;
    max-width: var(--measure);
  }

  .body.wide {
    max-width: none;
  }

  @media (min-width: 64rem) {
    section {
      grid-template-columns: var(--rail) minmax(0, 1fr);
      column-gap: var(--space-5);
      padding-block: var(--space-6);
    }
  }
</style>
