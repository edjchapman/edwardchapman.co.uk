---
interface Props {
  id: string;
  heading: string;
  /** Extra classes on the section element — e.g. u-wide to span the wide
   * canvas of the page grid. */
  class?: string;
}

const { id, heading, class: className } = Astro.props;
---

<section class:list={[className]} aria-labelledby={id}>
  <h2 id={id}>{heading}</h2>
  <slot />
</section>

<style>
  section {
    margin-block: var(--space-5) 0;
  }

  h2 {
    padding-bottom: var(--space-2);
    border-bottom: var(--rule);
  }
</style>
