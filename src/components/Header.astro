---
import { normalizePath } from "../lib/paths";
import { SITE } from "../lib/site";

const navItems = [
  { href: "/projects", label: "Projects" },
  { href: "/notes", label: "Notes" },
  { href: "/experience", label: "Experience" },
  { href: "/now", label: "Now" },
  { href: "/ask", label: "Ask" },
  { href: "/colophon", label: "Colophon" },
];
const currentPath = normalizePath(Astro.url.pathname);
---

<header>
  <div class="inner">
    <a class="site-name" href="/">{SITE.name}</a>
    <nav aria-label="Site">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentPath === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    border-bottom: var(--rule);
  }

  .inner {
    max-width: calc(var(--measure-wide) + 2 * var(--space-4));
    margin-inline: auto;
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
  }

  .site-name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-name:hover {
    text-decoration: underline;
  }

  /* Row gap holds the offset underline of the current page clear of a
   * wrapped second nav row on narrow viewports. */
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--color-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    letter-spacing: 0.01em;
    transition: color var(--duration-quick) var(--ease-out);
  }

  nav a:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }

  /* You-are-here in the accent: a settled underline, distinct from the
   * hover affordance. */
  nav a[aria-current="page"] {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
</style>
