---
import stamp from "../generated/build-stamp.json";
import { SITE } from "../lib/site";

// Build stamp (ADR-0030): real state from the build that produced this page;
// scripts/build-stamp.ts omits anything it couldn't observe.
const built = new Date(stamp.builtAt).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
const { sha, evals, lighthouse } = stamp as {
  sha?: string;
  evals?: { passed: number; total: number };
  lighthouse?: { conclusion: string; pr: number };
};
---

<footer>
  <div class="inner">
    <ul class="contact">
      <li><a href={SITE.github}>GitHub</a></li>
      <li><a href={SITE.linkedin}>LinkedIn</a></li>
      <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
    </ul>
    <ul class="meta">
      <li><a href="/now">Now</a></li>
      <li><a href="/colophon">Colophon</a></li>
      <li><a href="/privacy">Privacy</a></li>
      <li><a href={SITE.repo}>Source</a></li>
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
    <p class="copyright">© {new Date().getFullYear()} Ed Chapman</p>
    <p class="stamp">
      <span>Built <time datetime={stamp.builtAt}>{built}</time></span>
      {
        sha && (
          <span>
            commit <a href={`${SITE.repo}/commit/${sha}`}>{sha}</a>
          </span>
        )
      }
      {
        evals && (
          <span>
            <a href={`${SITE.repo}/blob/main/docs/evaluation.md`}>
              agent evals
            </a>{" "}
            {evals.passed}/{evals.total} passing
          </span>
        )
      }
      {
        lighthouse && (
          <span>
            Lighthouse budgets{" "}
            {lighthouse.conclusion === "success"
              ? "met"
              : lighthouse.conclusion}{" "}
            (<a href={`${SITE.repo}/pull/${lighthouse.pr}`}>#{lighthouse.pr}</a>
            )
          </span>
        )
      }
    </p>
  </div>
</footer>

<style>
  footer {
    border-top: var(--rule);
    margin-top: var(--space-6);
  }

  .inner {
    max-width: calc(var(--measure-wide) + 2 * var(--space-4));
    margin-inline: auto;
    padding: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* One quiet mono line under a dashed rule: the gates, made visible. */
  .stamp {
    flex-basis: 100%;
    max-width: none; /* the global p measure would cap it beside the copyright */
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    padding-top: var(--space-3);
    border-top: 1px dashed var(--color-rule-strong);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .stamp a {
    font-size: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .copyright {
    flex-basis: 100%;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  a {
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--duration-quick) var(--ease-out);
  }

  a:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }
</style>
