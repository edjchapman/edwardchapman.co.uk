---
import { SITE } from "../lib/site";
---

<footer>
  <div class="inner">
    <ul class="contact">
      <li><a href={SITE.github}>GitHub</a></li>
      <li><a href={SITE.linkedin}>LinkedIn</a></li>
      <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
    </ul>
    <ul class="meta">
      <li><a href="/colophon">Colophon</a></li>
      <li><a href="/privacy">Privacy</a></li>
      <li><a href={SITE.repo}>Source</a></li>
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
    <p class="copyright">© {new Date().getFullYear()} Ed Chapman</p>
  </div>
</footer>

<style>
  footer {
    border-top: var(--rule);
    margin-top: var(--space-6);
  }

  .inner {
    max-width: calc(var(--measure-wide) + 2 * var(--space-4));
    margin-inline: auto;
    padding: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .copyright {
    flex-basis: 100%;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  a {
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--duration-quick) var(--ease-out);
  }

  a:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }
</style>
