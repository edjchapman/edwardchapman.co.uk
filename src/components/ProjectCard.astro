---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  /** Heading level for the card title: 2 directly under a page h1
   * (/projects), 3 under a Section h2 (homepage). Visual size is pinned
   * by the .title class either way. */
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const { title, problem, built, differentiator, tech, repo, demo } =
  project.data;
---

<article>
  <Heading class="title">{title}</Heading>
  <p>{problem}</p>
  <p>{built}</p>
  <p>{differentiator}</p>
  <ul class="tech" aria-label="Technologies">
    {tech.map((tag) => <li>{tag}</li>)}
  </ul>
  <p class="links">
    <a href={`/projects/${project.id}`}>Case study</a>
    <a href={repo}>Repository</a>
    {demo && <a href={demo}>Live demo</a>}
  </p>
</article>

<style>
  article {
    padding: var(--space-4);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius);
    background: var(--color-paper-raised);
    box-shadow: var(--shadow-1);
    margin-bottom: var(--space-4);
  }

  .title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  /* Plain mono text with dot separators — bordered boxes read as tappable
   * controls, and these are labels. */
  .tech {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
  }

  .tech li {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .tech li + li::before {
    content: "·";
    margin-inline: var(--space-2);
    color: var(--color-rule);
  }

  .links {
    display: flex;
    gap: var(--space-3);
    margin: 0;
  }
</style>
