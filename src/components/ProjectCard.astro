---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  /** Heading level for the card title: 2 directly under a page h1
   * (/projects), 3 under a Section h2 (homepage). Visual size is pinned
   * by the .title class either way. */
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const { title, problem, built, differentiator, tech, metrics, repo, demo } =
  project.data;
---

<article>
  <Heading class="title">{title}</Heading>
  <p>{problem}</p>
  <p>{built}</p>
  <p>{differentiator}</p>
  {
    metrics.length > 0 && (
      <dl class="metrics" aria-label="Headline metrics">
        {metrics.map((metric) => (
          <div>
            <dt>{metric.label}</dt>
            <dd>{metric.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
  <ul class="tech" aria-label="Technologies">
    {tech.map((tag) => <li>{tag}</li>)}
  </ul>
  <p class="links">
    <a href={`/projects/${project.id}`}>Case study</a>
    <a href={repo}>Repository</a>
    {demo && <a href={demo}>Live demo</a>}
  </p>
</article>

<style>
  /* Cards live inside a .card-grid (global.css), which owns the spacing
   * between them and feeds the project counter. */
  article {
    counter-increment: project;
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius);
    background: var(--color-paper-raised);
    box-shadow: var(--shadow-1);
  }

  /* Editorial index number — decoration, not content: the alt-text syntax
   * ("/ ''") keeps it silent to assistive tech; older engines that lack the
   * syntax drop the number and the card reads unchanged. */
  article::before {
    content: counter(project, decimal-leading-zero) / "";
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin-bottom: var(--space-2);
  }

  .title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  /* Measured evidence, displayed as evidence: the figure leads visually
   * (column-reverse), the label sits beneath; DOM order stays label-first
   * for assistive tech. */
  .metrics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0 0 var(--space-3);
  }

  .metrics div {
    display: flex;
    flex-direction: column-reverse;
  }

  .metrics dt {
    color: var(--color-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
  }

  .metrics dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: var(--leading-tight);
    font-variant-numeric: tabular-nums;
  }

  /* Plain mono text with dot separators — bordered boxes read as tappable
   * controls, and these are labels. */
  .tech {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
  }

  .tech li {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .tech li + li::before {
    content: "·";
    margin-inline: var(--space-2);
    color: var(--color-rule);
  }

  /* Pinned to the card's bottom edge so links align across a grid row
   * regardless of how much copy each card carries. */
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin: auto 0 0;
  }
</style>
