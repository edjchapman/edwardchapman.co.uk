---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";

import Breadcrumbs from "../../components/Breadcrumbs.astro";
import JsonLd from "../../components/JsonLd.astro";
import Prose from "../../components/Prose.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  breadcrumbNode,
  personNode,
  softwareSourceCodeNode,
} from "../../lib/jsonld";
import { SITE } from "../../lib/site";

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { title, problem, tech, repo, demo } = project.data;
const { Content } = await render(project);

const relatedNotes = await getCollection(
  "notes",
  ({ data }) => !data.draft && data.relatedProject === project.id,
);

const projectUrl = `${SITE.origin}/projects/${project.id}`;
const crumbs = [
  { name: "Home", url: SITE.origin },
  { name: "Projects", url: `${SITE.origin}/projects` },
  { name: title, url: projectUrl },
];

// personNode() is included (not just referenced by @id) so the project's
// author resolves to a named entity on this page. Same @id across pages is
// merged by consumers, not duplicated.
const jsonLdNodes = [
  softwareSourceCodeNode({
    title,
    description: problem,
    tech,
    repo,
    url: projectUrl,
  }),
  personNode(),
  breadcrumbNode(crumbs),
];
---

<BaseLayout
  title={`${title} — Ed Chapman`}
  description={problem}
  image={`/og/projects/${project.id}.png`}
  type="article"
>
  <Breadcrumbs items={crumbs} />
  <article>
    <header>
      <h1>{title}</h1>
      <p class="problem">{problem}</p>
      <ul class="tech" aria-label="Technologies">
        {tech.map((tag) => <li>{tag}</li>)}
      </ul>
      <p class="links">
        <a href={repo}>Repository</a>
        {demo && <a href={demo}>Live demo</a>}
      </p>
    </header>
    <Prose><Content /></Prose>
    {
      relatedNotes.length > 0 && (
        <aside aria-label="Related writing">
          <p>Related writing:</p>
          <ul>
            {relatedNotes.map((note) => (
              <li>
                <a href={`/notes/${note.id}`}>{note.data.title}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </article>
  <p class="back"><a href="/projects">← All projects</a></p>
  <JsonLd nodes={jsonLdNodes} />
</BaseLayout>

<style>
  header {
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: var(--rule);
  }

  .problem {
    color: var(--color-muted);
    font-style: italic;
    font-size: var(--text-lg);
  }

  /* Labels, not controls — plain mono text with dot separators. */
  .tech {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
  }

  .tech li {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .tech li + li::before {
    content: "·";
    margin-inline: var(--space-2);
    color: var(--color-rule);
  }

  .links {
    display: flex;
    gap: var(--space-3);
    margin: 0;
  }

  .back {
    margin-top: var(--space-5);
  }

  aside {
    margin-top: var(--space-5);
    padding: var(--space-3);
    border: 1px solid var(--color-rule-strong);
    border-radius: var(--radius);
    background: var(--color-paper-raised);
    box-shadow: var(--shadow-1);
  }

  aside p,
  aside ul {
    margin: 0;
  }

  aside ul {
    list-style: none;
    padding: 0;
  }
</style>
