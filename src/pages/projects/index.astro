---
import { getCollection } from "astro:content";

import JsonLd from "../../components/JsonLd.astro";
import ProjectRow from "../../components/ProjectRow.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { collectionPageNode } from "../../lib/jsonld";
import { SITE } from "../../lib/site";

const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);

const description =
  "Selected projects with full case studies: architecture, engineering decisions, trade-offs, limitations, and what comes next.";

const collectionPage = collectionPageNode({
  name: "Projects",
  description,
  url: `${SITE.origin}/projects`,
  items: projects.map((project) => ({
    name: project.data.title,
    url: `${SITE.origin}/projects/${project.id}`,
  })),
});
---

<BaseLayout title="Projects — Ed Chapman" description={description}>
  <header class="head">
    <h1>Projects</h1>
    <p class="lede">
      Each project links to a case study covering the architecture, the
      decisions that carried weight, honest limitations, and what I'd do next.
    </p>
  </header>
  <div class="index">
    {
      projects.map((project) => (
        <ProjectRow project={project} headingLevel={2} />
      ))
    }
  </div>
  <JsonLd nodes={[collectionPage]} />
</BaseLayout>

<style>
  /* Header on the wide canvas so title and rows share one left edge. */
  .head {
    grid-column: wide;
  }

  .lede {
    color: var(--color-muted);
    margin-bottom: var(--space-5);
  }

  /* Same ruled index as the homepage (ADR-0030), on the wide canvas. */
  .index {
    grid-column: wide;
    display: grid;
    padding-top: var(--space-4);
    border-top: var(--rule);
  }
</style>
