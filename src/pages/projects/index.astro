---
import { getCollection } from "astro:content";

import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = (
  await getCollection("projects", ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Projects — Ed Chapman"
  description="Selected projects with full case studies: architecture, engineering decisions, trade-offs, limitations, and what comes next."
>
  <h1>Projects</h1>
  <p class="lede">
    Each project links to a case study covering the architecture, the decisions
    that carried weight, honest limitations, and what I'd do next.
  </p>
  {projects.map((project) => <ProjectCard project={project} />)}
</BaseLayout>

<style>
  .lede {
    color: var(--color-muted);
    margin-bottom: var(--space-4);
  }
</style>
