---
import { getCollection, getEntry, render } from "astro:content";

import Hero from "../components/Hero.astro";
import JsonLd from "../components/JsonLd.astro";
import ProjectRow from "../components/ProjectRow.astro";
import Section from "../components/Section.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { personNode, profilePageNode, webSiteNode } from "../lib/jsonld";
import { SITE } from "../lib/site";

const positioning = await getEntry("profile", "positioning");
const howIWork = await getEntry("profile", "how-i-work");
const experience = await getEntry("profile", "experience");
if (!positioning || !howIWork || !experience) {
  throw new Error("Homepage profile entries are missing from the collection");
}

const { Content: Positioning } = await render(positioning);
const { Content: HowIWork } = await render(howIWork);
const roles = experience.data.roles ?? [];

const projects = (
  await getCollection("projects", ({ data }) => data.featured && !data.draft)
).sort((a, b) => a.data.order - b.data.order);

// knowsAbout draws on every published project's tech, not just the featured
// ones shown above, so an unfeatured project's stack still counts. personNode
// dedupes; every entry is already public on that project's own page.
const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const knowsAbout = allProjects.flatMap((p) => p.data.tech);

const recentNotes = (await getCollection("notes", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <Hero
    tagline={positioning.data.tagline ?? SITE.description}
    eyebrow="Software engineer · London"
  >
    <Positioning />
  </Hero>

  <Section id="work" heading="Selected work" wideBody>
    <div class="work">
      {projects.map((project) => <ProjectRow project={project} />)}
    </div>
  </Section>

  <Section id="experience" heading="Experience">
    <ul class="roles">
      {
        roles.map((role) => (
          <li>
            <span class="org">
              {role.org} <small>· {role.sector}</small>
            </span>
            <span class="years">{role.years}</span>
            <span class="title">{role.title}</span>
          </li>
        ))
      }
    </ul>
    <p class="more">
      <a href="/experience">Full experience, skills and education →</a>
    </p>
  </Section>

  <Section id="how-i-work" heading="How I work">
    <div class="principles"><HowIWork /></div>
  </Section>

  <Section id="writing" heading="Writing">
    <ul class="notes">
      {
        recentNotes.map((note) => (
          <li>
            <time datetime={note.data.pubDate.toISOString().slice(0, 10)}>
              {formatDate(note.data.pubDate)}
            </time>
            <a href={`/notes/${note.id}`}>{note.data.title}</a>
          </li>
        ))
      }
    </ul>
    <p class="more"><a href="/notes">All notes →</a></p>
  </Section>

  <JsonLd
    nodes={[
      webSiteNode(),
      profilePageNode({ dateModified: positioning.data.updatedDate }),
      personNode({ knowsAbout }),
    ]}
  />
</BaseLayout>

<style>
  .work {
    display: grid;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .roles {
    display: grid;
    gap: var(--space-3);
  }

  .roles li {
    display: grid;
    column-gap: var(--space-4);
  }

  .org {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-lg);
  }

  .org small {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .title {
    color: var(--color-muted);
  }

  .years,
  .notes time {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  /* How I work renders as Markdown bullets ("**Lead.** text"); on wider
   * screens the bold lead hangs in its own column like a definition term. */
  .principles :global(ul) {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .principles :global(li) {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
    margin: 0;
  }

  .principles :global(strong) {
    display: block;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  .notes {
    display: grid;
    gap: var(--space-3);
  }

  .notes li {
    display: grid;
    gap: var(--space-1);
  }

  .notes a {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: var(--text-lg);
  }

  .more {
    margin: var(--space-4) 0 0;
    font-size: var(--text-sm);
  }

  @media (min-width: 40rem) {
    .roles li {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
    }

    .years {
      grid-row: 1;
      grid-column: 2;
    }

    .principles :global(li) {
      position: relative;
      padding-left: 13rem;
    }

    .principles :global(strong) {
      position: absolute;
      left: 0;
      width: 12rem;
      margin: 0;
      line-height: 1.4;
    }

    .notes li {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      align-items: baseline;
      column-gap: var(--space-4);
    }
  }
</style>
