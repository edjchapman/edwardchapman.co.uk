---
import { getCollection, getEntry, render } from "astro:content";

import AskCallout from "../components/AskCallout.astro";
import Hero from "../components/Hero.astro";
import JsonLd from "../components/JsonLd.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Prose from "../components/Prose.astro";
import Section from "../components/Section.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { personNode, profilePageNode, webSiteNode } from "../lib/jsonld";
import { SITE } from "../lib/site";

const positioning = await getEntry("profile", "positioning");
const howIWork = await getEntry("profile", "how-i-work");
const technicalFocus = await getEntry("profile", "technical-focus");
const contact = await getEntry("profile", "contact");
if (!positioning || !howIWork || !technicalFocus || !contact) {
  throw new Error("Homepage profile entries are missing from the collection");
}

const { Content: Positioning } = await render(positioning);
const { Content: HowIWork } = await render(howIWork);
const { Content: TechnicalFocus } = await render(technicalFocus);
const { Content: Contact } = await render(contact);

const projects = (
  await getCollection("projects", ({ data }) => data.featured && !data.draft)
).sort((a, b) => a.data.order - b.data.order);

// knowsAbout draws on every published project's tech, not just the featured
// ones shown above, so an unfeatured project's stack still counts. personNode
// dedupes; every entry is already public on that project's own page.
const allProjects = await getCollection("projects", ({ data }) => !data.draft);
const knowsAbout = allProjects.flatMap((p) => p.data.tech);

const recentNotes = (await getCollection("notes", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <Hero tagline={positioning.data.tagline ?? SITE.description} />
  <Prose><Positioning /></Prose>
  <AskCallout />

  <Section id="projects" heading="Selected projects">
    {projects.map((project) => <ProjectCard project={project} />)}
  </Section>

  <Section id="how-i-work" heading="How I work">
    <Prose><HowIWork /></Prose>
  </Section>

  <Section id="technical-focus" heading="Technical focus">
    <Prose><TechnicalFocus /></Prose>
  </Section>

  <Section id="recent-notes" heading="Recent notes">
    <ul class="recent-notes">
      {
        recentNotes.map((note) => (
          <li>
            <a href={`/notes/${note.id}`}>{note.data.title}</a>
            <time datetime={note.data.pubDate.toISOString().slice(0, 10)}>
              {formatDate(note.data.pubDate)}
            </time>
          </li>
        ))
      }
    </ul>
    <p class="all-notes"><a href="/notes">All notes →</a></p>
  </Section>

  <Section id="contact" heading="Contact">
    <Prose><Contact /></Prose>
  </Section>

  <p class="deeper">
    This site is a project too — the <a href="/colophon">colophon</a> explains how
    it's built, and full <a href="/projects">case studies</a> sit behind each project
    above. Questions about the work? <a href="/ask">Ask</a> — it answers from this
    site's published content only.
  </p>

  <JsonLd
    nodes={[
      webSiteNode(),
      profilePageNode({ dateModified: positioning.data.updatedDate }),
      personNode({ knowsAbout }),
    ]}
  />
</BaseLayout>

<style>
  .recent-notes {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .recent-notes li {
    margin-bottom: var(--space-3);
  }

  .recent-notes a {
    font-family: var(--font-serif);
    font-weight: 600;
  }

  .recent-notes time {
    display: block;
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-top: var(--space-1);
  }

  .all-notes {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
  }

  .deeper {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: var(--rule);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
