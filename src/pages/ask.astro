---
import AskForm from "../components/AskForm.tsx";
import BaseLayout from "../layouts/BaseLayout.astro";

// Released (Phase 4 gates passed, docs/evaluation.md): linked in the nav, in
// the sitemap, and indexable.
---

<BaseLayout
  title="Ask about Ed's work — Ed Chapman"
  description="Ask questions about Ed Chapman's published work and get grounded, cited answers."
>
  <h1>Ask about my work</h1>
  <p>
    This assistant answers questions about Ed's work using <strong
      >only the published content on this site</strong
    > — the case studies, notes, and profile pages. Every answer links its sources,
    and if the site doesn't cover something, it says so instead of guessing.
  </p>

  {
    /* client:only — the form is meaningless without JS (noscript covers that
      case), and skipping SSR removes the pre-hydration dead-click window. */
  }
  <AskForm client:only="react" />

  <noscript>
    <p>
      The ask feature needs JavaScript. Everything it knows comes from the
      published pages, so you can read those directly instead: start with the
      <a href="/projects">projects</a>.
    </p>
  </noscript>

  <section class="notes" aria-label="About this feature">
    <p>
      Answers are <strong>generated</strong> and may be imperfect; they're grounded
      in published pages, not a live line to Ed. Questions you submit are processed
      by an external model provider (Anthropic) to produce the answer — see the <a
        href="/privacy">privacy page</a
      >. Don't include personal or sensitive information in a question.
    </p>
  </section>
</BaseLayout>

<style>
  .notes {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: var(--rule);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>

<style is:global>
  .ask label {
    display: block;
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .ask .row {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .ask input {
    flex: 1;
    min-width: 16rem;
    font: inherit;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    background: var(--color-paper-raised);
    color: var(--color-ink);
  }

  .ask input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .ask button {
    font: inherit;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    background: var(--color-ink);
    color: var(--color-paper);
    cursor: pointer;
  }

  .ask button:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .ask .examples-label {
    margin-top: var(--space-4);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .ask .examples {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .ask .examples button {
    background: var(--color-paper-raised);
    color: var(--color-ink);
    font-size: var(--text-sm);
  }

  .ask .examples button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .ask .status {
    margin-top: var(--space-4);
  }

  .ask .error {
    color: var(--color-error);
  }

  .ask .answer {
    padding: var(--space-4);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    background: var(--color-paper-raised);
  }

  .ask .answer sup.citation {
    font-size: 0.75em;
    line-height: 0;
  }

  .ask .answer sup.citation a {
    text-decoration: none;
  }

  .ask .sources-label {
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  .ask .sources {
    margin: 0 0 var(--space-3);
    padding-left: 1.25em;
  }

  .ask .disclosure {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
