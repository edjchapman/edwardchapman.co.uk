---
import { getCollection } from "astro:content";

import JsonLd from "../../components/JsonLd.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { collectionPageNode } from "../../lib/jsonld";
import { SITE } from "../../lib/site";

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const description =
  "Technical writing: AI engineering, evaluation, reliability, and the practice of building with guardrails.";

const collectionPage = collectionPageNode({
  name: "Notes",
  description,
  url: `${SITE.origin}/notes`,
  items: notes.map((note) => ({
    name: note.data.title,
    url: `${SITE.origin}/notes/${note.id}`,
  })),
});

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
---

<BaseLayout title="Notes — Ed Chapman" description={description}>
  <h1>Notes</h1>
  <p class="lede">
    Occasional technical writing — mostly the engineering around AI systems:
    evaluation, grounding, and guardrails.
  </p>
  <ul class="notes u-wide">
    {
      notes.map((note) => (
        <li>
          <a href={`/notes/${note.id}`}>{note.data.title}</a>
          <time datetime={note.data.pubDate.toISOString().slice(0, 10)}>
            {formatDate(note.data.pubDate)}
          </time>
          <p>{note.data.description}</p>
        </li>
      ))
    }
  </ul>
  <JsonLd nodes={[collectionPage]} />
</BaseLayout>

<style>
  .lede {
    color: var(--color-muted);
    margin-bottom: var(--space-5);
  }

  .notes {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .notes li {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: var(--rule);
  }

  /* Marginalia dates on the wide canvas: each entry mirrors the page grid —
   * titles and descriptions keep the reading column's left edge, dates hang
   * in the left margin. The rules under each entry span the full wide track.
   * (64rem — the one desktop breakpoint; see tokens.css.) */
  @media (min-width: 64rem) {
    /* Track arithmetic mirrors the main grid exactly (side tracks are
     * (wide − measure) / 2), so column 2 shares the reading column's left
     * edge; a gap would shift it. The date's own padding provides the
     * separation instead. */
    .notes li {
      display: grid;
      grid-template-columns: 1fr min(var(--measure), 100%) 1fr;
    }

    .notes li > * {
      grid-column: 2;
    }

    .notes li time {
      grid-column: 1;
      grid-row: 1;
      justify-self: end;
      align-self: baseline;
      text-align: right;
      margin: 0;
      padding-right: var(--space-4);
    }
  }

  .notes a {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  time {
    display: block;
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-block: var(--space-1) var(--space-2);
  }

  .notes p {
    margin: 0;
    color: var(--color-muted);
  }
</style>
