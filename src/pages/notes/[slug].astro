---
import type { GetStaticPaths } from "astro";
import { getCollection, getEntry, render } from "astro:content";

import Breadcrumbs from "../../components/Breadcrumbs.astro";
import JsonLd from "../../components/JsonLd.astro";
import Prose from "../../components/Prose.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogPostingNode, breadcrumbNode, personNode } from "../../lib/jsonld";
import { SITE } from "../../lib/site";

export const getStaticPaths = (async () => {
  const notes = await getCollection("notes", ({ data }) => !data.draft);
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}) satisfies GetStaticPaths;

const { note } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  relatedProject,
  canonicalURL,
} = note.data;
const { Content } = await render(note);

const related = relatedProject
  ? await getEntry("projects", relatedProject)
  : undefined;

// Notes sharing at least one tag, newest first, excluding this one — denser
// internal linking without a separate (and, at this corpus size, thin) tag
// page. Mirrors the related-project pattern above.
const relatedNotes =
  tags.length > 0
    ? (
        await getCollection(
          "notes",
          ({ id, data }) =>
            !data.draft &&
            id !== note.id &&
            data.tags.some((tag) => tags.includes(tag)),
        )
      )
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
        .slice(0, 3)
    : [];

const iso = (date: Date) => date.toISOString().slice(0, 10);
const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const noteUrl = `${SITE.origin}/notes/${note.id}`;
// One breadcrumb array feeds both the visible trail and the JSON-LD, so they
// can never disagree.
const crumbs = [
  { name: "Home", url: SITE.origin },
  { name: "Notes", url: `${SITE.origin}/notes` },
  { name: title, url: noteUrl },
];

// personNode() is included (not just referenced by @id) so the article's
// author/publisher resolve to a named entity on this page — Google validates
// @id references within a page. Same @id across pages is merged, not
// duplicated; the homepage node additionally carries knowsAbout.
const jsonLdNodes = [
  blogPostingNode({
    title,
    description,
    pubDate,
    updatedDate,
    tags,
    url: noteUrl,
    imageUrl: `${SITE.origin}/og/notes/${note.id}.png`,
  }),
  personNode(),
  breadcrumbNode(crumbs),
];
---

<BaseLayout
  title={`${title} — Ed Chapman`}
  description={description}
  image={`/og/notes/${note.id}.png`}
  type="article"
  canonical={canonicalURL}
>
  <Breadcrumbs items={crumbs} />
  <article>
    <header>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={iso(pubDate)}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <span>
              · updated{" "}
              <time datetime={iso(updatedDate)}>{formatDate(updatedDate)}</time>
            </span>
          )
        }
      </p>
      {
        tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>
    <Prose><Content /></Prose>
    {
      related && !related.data.draft && (
        <aside aria-label="Related project">
          <p>
            Related project:
            <a href={`/projects/${related.id}`}>{related.data.title}</a>
          </p>
        </aside>
      )
    }
    {
      relatedNotes.length > 0 && (
        <aside aria-label="Related notes">
          <p>Related notes:</p>
          <ul>
            {relatedNotes.map((other) => (
              <li>
                <a href={`/notes/${other.id}`}>{other.data.title}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </article>
  <p class="back"><a href="/notes">← All notes</a></p>
  <JsonLd nodes={jsonLdNodes} />
</BaseLayout>

<style>
  header {
    margin-bottom: var(--space-4);
  }

  .meta {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
  }

  .tags li {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    border: var(--rule);
    border-radius: var(--radius);
    padding: 0 var(--space-2);
  }

  aside {
    margin-top: var(--space-5);
    padding: var(--space-3);
    border: var(--rule);
    border-radius: var(--radius);
    background: var(--color-paper-raised);
  }

  aside p,
  aside ul {
    margin: 0;
  }

  aside ul {
    list-style: none;
    padding: 0;
    margin-top: var(--space-2);
  }

  .back {
    margin-top: var(--space-5);
  }
</style>
