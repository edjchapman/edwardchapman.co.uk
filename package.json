{
  "name": "edwardchapman.co.uk",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
  "scripts": {
    "dev": "astro dev",
    "corpus": "node scripts/build-agent-corpus.ts",
    "og-cards": "node scripts/build-og-cards.ts",
    "icons": "node scripts/build-icons.ts",
    "llms": "node scripts/build-llms-txt.ts",
    "build": "pnpm run corpus && pnpm run icons && pnpm run og-cards && pnpm run llms && astro build && node scripts/sanitize-build-output.ts",
    "preview": "wrangler dev --config dist/server/wrangler.json --var ASK_MODEL_MODE:fake",
    "typecheck": "pnpm run corpus && astro check",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@astrojs/cloudflare": "^14.1.2",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/source-serif-4": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^3.0.1",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "satori": "^0.26.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0",
    "yaml": "^2.9.0"
  }
}
