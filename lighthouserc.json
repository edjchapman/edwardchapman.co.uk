{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec wrangler dev --config dist/server/wrangler.json --port 8788",
      "startServerReadyPattern": "Ready on",
      "url": [
        "http://localhost:8788/",
        "http://localhost:8788/projects/foreman",
        "http://localhost:8788/notes/llm-as-judge-as-a-ci-quality-gate",
        "http://localhost:8788/ask"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
